{
  "rewrites": [
    // CRITICAL: Serve the high-fidelity CETI standalone tracker (public/index.html) at the production root URL.
    // This ensures https://your-vercel-domain.vercel.app/ shows the beautiful bilingual Colombia Election Tracker
    // exactly as the citizen deliverable. The Next.js app shell is bypassed at "/" while /api/* routes remain functional.
    { "source": "/", "destination": "/index.html" }
  ],
  "crons": [
    // DISABLED by default for cost reasons on election day.
    // The heavy Grok synthesis seed (loaded statically) is the recommended fast/cheap path.
    // Uncomment only if you explicitly want automatic expensive refreshes.
    // {
    //   "path": "/api/ingest?region=colombia&secret=YOUR_INGEST_SECRET",
    //   "schedule": "*/12 * * * *"
    // }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=60" }
      ]
    }
  ],
  // Production election-day configuration
  "trailingSlash": false,
  "cleanUrls": true
}
